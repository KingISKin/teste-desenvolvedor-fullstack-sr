APP_NAME="Financial Import"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance
DB_USERNAME=finance
DB_PASSWORD=secret

# Stateless token API: sessions are never persisted.
SESSION_DRIVER=array

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# phpredis (C extension, installed in the Docker image) is faster than predis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_TOKEN_EXPIRATION=480

DEMO_USER_NAME="Demo User"
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=change-me-please

IMPORTS_MAX_UPLOAD_KB=20480
IMPORTS_CHUNK_SIZE=1000
DASHBOARD_CACHE_TTL=3600
