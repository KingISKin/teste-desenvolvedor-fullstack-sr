# Optional overrides for docker-compose.yml (copy to .env). Every variable
# has a local-friendly default, so the stack also starts without this file.
# Change every secret before exposing the stack anywhere.

WEB_PORT=8080

# Leave empty to let the app container generate one on first boot.
APP_KEY=
LOG_LEVEL=info

DB_DATABASE=finance
DB_USERNAME=finance
DB_PASSWORD=finance-secret
DB_ROOT_PASSWORD=root-secret

REDIS_PASSWORD=redis-secret

# Token lifetime in minutes.
SANCTUM_TOKEN_EXPIRATION=480

# There is no registration: this account is created (or re-synced) on boot.
DEMO_USER_NAME="Demo User"
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=password
